diff --git a/pcsx2-gt4gs/IOSPresentation.mm b/pcsx2-gt4gs/IOSPresentation.mm
new file mode 100644
index 000000000..d1a26e1f7
--- /dev/null
+++ b/pcsx2-gt4gs/IOSPresentation.mm
@@ -0,0 +1,70 @@
+// SPDX-FileCopyrightText: 2026 GT4Recomp contributors
+// SPDX-License-Identifier: GPL-3.0+
+//
+// GT4Recomp iOS port: the GT4GSMac presentation interface (MacPresentation.h) inside the game app. iOS has one process,
+// so there is no remote Core Animation context to share: the game app creates a view over its window and a Metal layer
+// in it on the main thread, and hands both over with gt4gs_ios_set_host before it starts the GS thread. The Metal device
+// then draws into that layer from the GS thread and never needs the main thread (GSDeviceMTL.mm, TARGET_OS_IPHONE),
+// because the app's main thread runs the game and may itself be waiting for the GS.
+
+#if ! __has_feature(objc_arc)
+	#error "Compile this with -fobjc-arc"
+#endif
+
+#include "MacPresentation.h"
+
+#import <QuartzCore/QuartzCore.h>
+#import <UIKit/UIKit.h>
+
+#include <algorithm>
+#include <cstdio>
+
+namespace
+{
+	UIView* s_view = nil;
+	CAMetalLayer* s_layer = nil;
+	float s_scale = 1.0f;
+} // namespace
+
+// Called by the game app (main thread) before the GS thread starts. view: a UIView over the game picture; layer: a
+// CAMetalLayer that fills it; scale: pixels per point.
+extern "C" void gt4gs_ios_set_host(void* view, void* layer, float scale)
+{
+	s_view = (__bridge UIView*)view;
+	s_layer = (__bridge CAMetalLayer*)layer;
+	s_scale = scale > 0.0f ? scale : 1.0f;
+}
+
+bool GT4GSMac::CreateLiveView(WindowInfo* wi, uint32_t width, uint32_t height)
+{
+	if (!s_view || !s_layer)
+	{
+		std::fprintf(stderr, "gt4-gs: the game app gave no view for the picture\n");
+		return false;
+	}
+	wi->type = WindowInfo::Type::MacOS;
+	wi->window_handle = (__bridge void*)s_view;
+	wi->surface_handle = (__bridge void*)s_layer;
+	wi->surface_width = width;
+	wi->surface_height = height;
+	wi->surface_scale = s_scale;
+	return true;
+}
+
+void GT4GSMac::DestroyLiveView() {}
+
+bool GT4GSMac::AttachToGameWindow(uint32_t width, uint32_t height)
+{
+	if (!s_layer)
+		return false;
+	// The layer's drawable size follows the device's surface (GSDeviceMTL::UpdateWindow); nothing to move here.
+	std::fprintf(stderr, "gt4-gs: drawing into the game app's view (%ux%u pixels)\n", width, height);
+	return true;
+}
+
+void GT4GSMac::Resize(uint32_t, uint32_t) {}
+
+uint64_t GT4GSMac::PresentationId()
+{
+	return 0;
+}
