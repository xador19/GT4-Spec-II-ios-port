+
+namespace
+{
+	// metal_pipelines.bin: a header, then one record per pipeline in the order the game first needed them.
+	constexpr u32 kPipelineListMagic = 0x4C50544D; // "MTPL"
+	constexpr u32 kPipelineListVersion = 1;
+	struct PipelineListHeader
+	{
+		u32 magic;
+		u32 version;
+		u32 record_size;
+		u32 selector_size;
+	};
+	struct PipelineListRecord
+	{
+		PipelineSelectorMTL selector;
+		u32 blend_key;
+		u8 color_mask_key;
+		u8 pad[3];
+	};
+	static_assert(sizeof(PipelineListRecord) == 32);
+	// Prebuilding stops after this long; the rest are built when the game first draws with them, as before.
+	constexpr double kPrebuildBudgetSeconds = 10.0;
+
+	std::string PipelineListPath()
