+
+void GSDeviceMTL::PrebuildRecordedHWPipelines()
+{ @autoreleasepool {
+	const std::string path = PipelineListPath();
+	std::vector<PipelineListRecord> records;
+	if (std::FILE* file = std::fopen(path.c_str(), "rb"))
+	{
+		PipelineListHeader header = {};
+		if (std::fread(&header, sizeof(header), 1, file) == 1 && header.magic == kPipelineListMagic &&
+			header.version == kPipelineListVersion && header.record_size == sizeof(PipelineListRecord) &&
+			header.selector_size == sizeof(PipelineSelectorMTL))
+		{
+			PipelineListRecord record;
+			while (std::fread(&record, sizeof(record), 1, file) == 1)
+				records.push_back(record);
+		}
+		else
+		{
+			Console.WarningFmt("Metal: {} is from another build; starting a new pipeline list", path);
+		}
+		std::fclose(file);
+	}
+
+	const Common::Timer timer;
+	size_t built = 0;
+	for (const PipelineListRecord& record : records)
+	{
+		if (timer.GetTimeSeconds() > kPrebuildBudgetSeconds)
+			break;
+		if (m_hw_pipeline.find(record.selector) != m_hw_pipeline.end())
+			continue;
+		GSHWDrawConfig::BlendState blend;
+		blend.key = record.blend_key;
+		GSHWDrawConfig::ColorMaskSelector cms;
+		cms.key = record.color_mask_key;
+		CreateHWPipeline(record.selector, blend, cms);
+		built++;
+	}
+	Console.WriteLnFmt("Metal: prebuilt {} of {} recorded draw pipelines in {:.0f} ms", built, records.size(),
+		timer.GetTimeMilliseconds());
+
+	// Rewrite the list with what is known now (drops duplicates and anything from another build), then append to it.
+	m_pipeline_record = std::fopen(path.c_str(), "wb");
+	if (!m_pipeline_record)
+	{
+		Console.WarningFmt("Metal: cannot write {}; pipelines are not recorded", path);
+		return;
+	}
+	const PipelineListHeader header = {kPipelineListMagic, kPipelineListVersion, sizeof(PipelineListRecord), sizeof(PipelineSelectorMTL)};
+	std::fwrite(&header, sizeof(header), 1, m_pipeline_record);
+	std::unordered_set<PipelineSelectorMTL> written;
+	for (const PipelineListRecord& record : records)
+		if (written.insert(record.selector).second)
+			std::fwrite(&record, sizeof(record), 1, m_pipeline_record);
+	std::fflush(m_pipeline_record);
+}}
+
+void GSDeviceMTL::RecordHWPipeline(const PipelineSelectorMTL& fullsel, GSHWDrawConfig::BlendState blend, GSHWDrawConfig::ColorMaskSelector cms)
+{
+	if (!m_pipeline_record)
+		return;
+	PipelineListRecord record = {};
+	record.selector = fullsel;
+	record.blend_key = blend.key;
+	record.color_mask_key = cms.key;
+	std::fwrite(&record, sizeof(record), 1, m_pipeline_record);
+	std::fflush(m_pipeline_record);
 }
 
