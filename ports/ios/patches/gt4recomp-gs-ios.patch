+// SPDX-License-Identifier: GPL-3.0+
+// GT4Recomp iOS port: iOS has no optical drives (and no IOKit storage API). The drive source never opens, and no drive is
+// listed, so PCSX2 behaves as on a computer without a disc drive. The GS core in the game app never reads discs.
+#include "CDVD/CDVDdiscReader.h"
+
+#include "common/Error.h"
+
+IOCtlSrc::IOCtlSrc(std::string filename)
+	: m_filename(std::move(filename))
+{
+}
+
