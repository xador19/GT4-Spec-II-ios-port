@@ -0,0 +1,135 @@
+// SPDX-FileCopyrightText: 2026 GT4Recomp contributors (based on common/CocoaTools.mm, 2002-2026 PCSX2 Dev Team)
+// SPDX-License-Identifier: GPL-3.0+
+//
+// GT4Recomp iOS port: the CocoaTools functions on UIKit. On iOS the GS core runs inside the game app; its "window" is a
+// UIView the app owns (WindowInfo::window_handle), and the Metal layer is a sublayer that fills it. Functions for the
+// desktop frontend (menus, trash, Finder, relaunch, windows and the Cocoa event loop) have no iOS meaning and do
+// nothing.
+
+#if ! __has_feature(objc_arc)
+	#error "Compile this with -fobjc-arc"
+#endif
+
+#include "CocoaTools.h"
+#include "Console.h"
+#include "HostSys.h"
+#include "WindowInfo.h"
+
+#include <UIKit/UIKit.h>
+#include <QuartzCore/QuartzCore.h>
+
+// MARK: - Metal Layers
+
+bool CocoaTools::CreateMetalLayer(WindowInfo* wi)
+{
+	if (![NSThread isMainThread])
+	{
+		bool ret;
+		dispatch_sync(dispatch_get_main_queue(), [&ret, wi]{ ret = CreateMetalLayer(wi); });
+		return ret;
+	}
+
+	CAMetalLayer* layer = [CAMetalLayer layer];
+	if (!layer)
+	{
+		Console.Error("Failed to create Metal layer.");
+		return false;
+	}
+
+	UIView* view = (__bridge UIView*)wi->window_handle;
+	layer.frame = view.bounds;
+	layer.contentsScale = view.window ? view.window.screen.nativeScale : UIScreen.mainScreen.nativeScale;
+	[view.layer addSublayer:layer];
+	wi->surface_handle = (__bridge_retained void*)layer;
+	return true;
+}
+
+void CocoaTools::DestroyMetalLayer(WindowInfo* wi)
+{
+	if (![NSThread isMainThread])
+	{
+		dispatch_sync_f(dispatch_get_main_queue(), wi, [](void* ctx){ DestroyMetalLayer(static_cast<WindowInfo*>(ctx)); });
+		return;
+	}
+
+	CAMetalLayer* layer = (__bridge_transfer CAMetalLayer*)wi->surface_handle;
+	if (!layer)
+		return;
+	wi->surface_handle = nullptr;
+	[layer removeFromSuperlayer];
+}
+
+std::optional<float> CocoaTools::GetViewRefreshRate(const WindowInfo& wi)
+{
+	if (![NSThread isMainThread])
+	{
+		std::optional<float> ret;
+		dispatch_sync(dispatch_get_main_queue(), [&ret, wi]{ ret = GetViewRefreshRate(wi); });
+		return ret;
+	}
+
+	UIView* const view = (__bridge UIView*)wi.window_handle;
+	UIScreen* screen = view.window ? view.window.screen : UIScreen.mainScreen;
+	return static_cast<float>(screen.maximumFramesPerSecond);
+}
+
+// MARK: - Desktop frontend functions (no iOS meaning)
+
+void CocoaTools::MarkHelpMenu(void*) {}
+
+bool Common::PlaySoundAsync(const char*)
+{
+	return false;
+}
+
+std::optional<std::string> CocoaTools::GetBundlePath()
+{
+	@autoreleasepool {
+		return std::string(NSBundle.mainBundle.bundlePath.fileSystemRepresentation);
+	}
+}
+
+std::optional<std::string> CocoaTools::GetNonTranslocatedBundlePath()
+{
+	return GetBundlePath();
+}
+
+std::optional<std::string> CocoaTools::MoveToTrash(std::string_view)
+{
+	return std::nullopt;
+}
+
+bool CocoaTools::DelayedLaunch(std::string_view)
+{
+	return false;
+}
+
+bool CocoaTools::ShowInFinder(std::string_view)
+{
+	return false;
+}
+
+std::optional<std::string> CocoaTools::GetResourcePath()
+{
+	@autoreleasepool {
+		// The app bundle is flat on iOS: PCSX2's resources sit in a pcsx2/ folder at its root (codesign refuses a
+		// top-level folder named "resources" in an iOS bundle).
+		return std::string([NSBundle.mainBundle.resourcePath stringByAppendingString:@"/pcsx2"].UTF8String);
+	}
+}
+
+void* CocoaTools::CreateWindow(std::string_view, u32, u32)
+{
+	return nullptr;
+}
+
+void CocoaTools::DestroyWindow(void*) {}
+
+void CocoaTools::GetWindowInfoFromWindow(WindowInfo* wi, void*)
+{
+	wi->type = WindowInfo::Type::Surfaceless;
+}
+
+void CocoaTools::RunCocoaEventLoop(bool) {}
+
+void CocoaTools::StopMainThreadEventLoop() {}
